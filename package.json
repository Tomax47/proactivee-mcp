{
  "name": "proactive-ide-mcp",
  "version": "0.1.0",
  "description": "Restricted, stdio-only MCP server that connects Cursor and Claude Code to Proactive",
  "private": true,
  "type": "module",
  "bin": { "proactive-ide-mcp": "build/index.js" },
  "files": ["build"],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsx src/index.ts",
    "start:http": "node build/http.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
